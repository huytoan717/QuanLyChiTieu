<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:background="@drawable/bg_bottom_nav"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/btnTabHome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minWidth="48dp"
        android:minHeight="64dp"
        android:background="@drawable/bg_nav_ripple"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">
        <ImageView
            android:id="@+id/imgTabHome"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_home"
            app:tint="@color/cyan_accent" />
        <TextView
            android:id="@+id/txtTabHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="@string/layout_bottom_navigation_txt_tab_home_text"
            android:textColor="@color/cyan_accent"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnTabReport"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minWidth="48dp"
        android:minHeight="64dp"
        android:background="@drawable/bg_nav_ripple"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">
        <ImageView
            android:id="@+id/imgTabReport"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_bar_chart"
            app:tint="@color/text_muted" />
        <TextView
            android:id="@+id/txtTabReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="@string/layout_bottom_navigation_txt_tab_report_text"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:importantForAccessibility="no">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnFabAdd"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_fab_ripple"
            android:clickable="true"
            android:contentDescription="@string/activity_add_transaction_2_text"
            android:elevation="4dp"
            android:focusable="true"
            android:padding="14dp"
            app:srcCompat="@drawable/ic_add" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/btnTabBudget"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minWidth="48dp"
        android:minHeight="64dp"
        android:background="@drawable/bg_nav_ripple"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">
        <ImageView
            android:id="@+id/imgTabBudget"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_wallet"
            app:tint="@color/text_muted" />
        <TextView
            android:id="@+id/txtTabBudget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="@string/layout_bottom_navigation_txt_tab_budget_text"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnTabAccount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minWidth="48dp"
        android:minHeight="64dp"
        android:background="@drawable/bg_nav_ripple"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">
        <ImageView
            android:id="@+id/imgTabAccount"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_person"
            app:tint="@color/text_muted" />
        <TextView
            android:id="@+id/txtTabAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="@string/layout_bottom_navigation_txt_tab_account_text"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
