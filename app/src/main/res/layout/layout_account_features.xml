<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/layout_account_features_1_text"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:breakStrategy="simple" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical">

        <com.nhom9.quanlychitieu.ui.components.AdaptiveLinearLayout
            android:id="@+id/btnExportData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:padding="14dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:enabled="false">

            <LinearLayout
                android:baselineAligned="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/featIcon1"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_translucent">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/layout_account_features_2_contentdescription"
                        android:src="@drawable/ic_export"
                        app:tint="@color/text_secondary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/layout_account_features_3_text"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:breakStrategy="simple" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/layout_account_features_4_text"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:enabled="false"
                        android:clickable="false"
                        android:focusable="false"
                        android:breakStrategy="simple" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/layout_account_features_5_text"
                android:textColor="@color/cyan_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp"
                android:enabled="false"
                android:clickable="false"
                android:focusable="false"
                android:breakStrategy="simple" />
        </com.nhom9.quanlychitieu.ui.components.AdaptiveLinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="14dp"
            android:background="@color/glass_card_stroke" />

        <com.nhom9.quanlychitieu.ui.components.AdaptiveLinearLayout
            android:id="@+id/btnCloudSync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:padding="14dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:enabled="false">

            <LinearLayout
                android:baselineAligned="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/featIcon2"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_translucent">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/layout_account_features_6_contentdescription"
                        android:src="@drawable/ic_cloud_sync"
                        app:tint="@color/text_secondary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/layout_account_features_7_text"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:breakStrategy="simple" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/layout_account_features_8_text"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:breakStrategy="simple" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/layout_account_features_5_text"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp"
                android:enabled="false"
                android:clickable="false"
                android:focusable="false"
                android:breakStrategy="simple" />
        </com.nhom9.quanlychitieu.ui.components.AdaptiveLinearLayout>
    </LinearLayout>
</LinearLayout>
